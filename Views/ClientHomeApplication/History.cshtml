@model MVC_Project_Freelance.Models.ClientApplicantsPageView
@{
    ViewBag.Title = "Application History";
}

<h2>Application History</h2>
<a href="@Url.Action("ViewApplicants")">Back to pending</a> |
<a href="@Url.Action("History", new { filter = "All" })">All (@Model.TotalCount)</a> |
<a href="@Url.Action("History", new { filter = "Accepted" })">Accepted (@Model.AcceptedCount)</a> |
<a href="@Url.Action("History", new { filter = "Rejected" })">Rejected (@Model.RejectedCount)</a>

@foreach (var a in Model.Applicants)
{
    <div style="border:1px solid #ccc; padding:12px; margin:12px 0; border-radius:8px;">
        <h4>
            @a.FName - @a.PTitle
            <span style="color:@(a.AStatus == 1 ? "green" : "red")">
                [@(a.AStatus == 1 ? "Accepted" : "Rejected")]
            </span>
        </h4>
        <p>
            @a.FEmail | @a.FPhone<br />
            @if (!string.IsNullOrEmpty(a.DRemarks))
            {<text><b>Remarks:</b> @a.DRemarks<br /></text>}
            @if (a.DDate.HasValue)
            {<text><b>Decided on:</b> @a.DDate.Value.ToString("dd MMM yyyy")</text>}
        </p>
    </div>
}