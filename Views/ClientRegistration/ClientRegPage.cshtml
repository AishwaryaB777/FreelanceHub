@model MVC_Project_Freelance.Models.ClientInsertClass

@{
    ViewBag.Title = "Client Registration";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .client-register-page {
        min-height: calc(100vh - 70px);
        background: radial-gradient(circle at 12% 18%, rgba(212, 20, 20, 0.10), transparent 40%), radial-gradient(circle at 88% 85%, rgba(255, 140, 0, 0.12), transparent 40%), linear-gradient(135deg, #fff5f3, #ffe9e4 55%, #fff8f0);
        padding: 45px 20px;
    }

    .register-container {
        max-width: 1050px;
        margin: auto;
        background: #ffffff;
        border-radius: 22px;
        overflow: hidden;
        box-shadow: 0 25px 60px rgba(160, 20, 20, 0.18), 0 4px 14px rgba(160, 20, 20, 0.08);
        display: flex;
        border-top: 4px solid #c11212;
    }

    /* LEFT SIDE */

    .register-left {
        width: 38%;
        background: linear-gradient(160deg, #5c0000 0%, #a80d0d 50%, #e8431a 100%);
        color: white;
        padding: 55px 40px;
        display: flex;
        flex-direction: column;
        justify-content: center;
        position: relative;
        overflow: hidden;
    }

        .register-left::before {
            content: "";
            position: absolute;
            width: 300px;
            height: 300px;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.08);
            top: -110px;
            right: -110px;
        }

        .register-left::after {
            content: "";
            position: absolute;
            width: 220px;
            height: 220px;
            border-radius: 50%;
            background: rgba(255, 190, 60, 0.14);
            bottom: -80px;
            left: -80px;
        }

    .brand-icon {
        width: 58px;
        height: 58px;
        border-radius: 16px;
        background: rgba(255, 255, 255, 0.18);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 26px;
        margin-bottom: 25px;
        box-shadow: 0 8px 20px rgba(0, 0, 0, 0.18);
        border: 1px solid rgba(255, 255, 255, 0.25);
        position: relative;
        z-index: 1;
    }

    .register-left h1 {
        font-size: 34px;
        font-weight: 700;
        line-height: 1.2;
        margin-bottom: 18px;
        text-shadow: 0 3px 12px rgba(0, 0, 0, 0.25);
        position: relative;
        z-index: 1;
    }

    .register-left p {
        color: #ffe9e4;
        font-size: 15px;
        line-height: 1.7;
        margin-bottom: 35px;
        position: relative;
        z-index: 1;
    }

    .benefit {
        display: flex;
        align-items: center;
        margin-bottom: 18px;
        font-size: 14px;
        color: #fff8f6;
        position: relative;
        z-index: 1;
    }

    .benefit-icon {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.18);
        display: flex;
        align-items: center;
        justify-content: center;
        margin-right: 12px;
        border: 1px solid rgba(255, 255, 255, 0.3);
    }

    /* RIGHT SIDE */

    .register-right {
        width: 62%;
        padding: 45px 50px;
        background: #ffffff;
    }

    .form-heading {
        margin-bottom: 30px;
    }

        .form-heading h2 {
            font-size: 27px;
            font-weight: 700;
            color: #3a0505;
            margin-bottom: 6px;
        }

        .form-heading p {
            color: #8c6666;
            font-size: 14px;
        }

    .section-title {
        font-size: 15px;
        font-weight: 700;
        color: #a80d0d;
        margin: 25px 0 15px;
        padding-bottom: 8px;
        border-bottom: 2px solid #fbdcd6;
    }

    .form-group {
        margin-bottom: 18px;
    }

    .form-label {
        display: block;
        font-size: 13px;
        font-weight: 600;
        color: #552020;
        margin-bottom: 7px;
    }

    .form-control {
        width: 100%;
        height: 45px;
        border: 1px solid #f0d3cc;
        border-radius: 10px;
        padding: 0 13px;
        font-size: 14px;
        color: #333;
        background: #fffaf9;
        transition: all 0.2s ease;
        box-sizing: border-box;
    }

    textarea.form-control {
        height: 90px;
        padding-top: 12px;
        resize: vertical;
    }

    .form-control:focus {
        border-color: #d41414;
        background: #ffffff;
        box-shadow: 0 0 0 4px rgba(212, 20, 20, 0.10);
        outline: none;
    }

    .row-flex {
        display: flex;
        gap: 18px;
    }

        .row-flex .form-group {
            flex: 1;
        }

    .photo-box {
        border: 2px dashed #eba79b;
        border-radius: 12px;
        padding: 15px;
        background: #fff6f4;
        transition: all 0.2s ease;
    }

        .photo-box:hover {
            border-color: #d41414;
            background: #fff0ed;
        }

        .photo-box input {
            width: 100%;
            font-size: 13px;
        }

    .register-btn {
        width: 100%;
        height: 50px;
        border: none;
        border-radius: 12px;
        background: linear-gradient(135deg, #a80d0d, #e0201a, #ff5a1f);
        color: white;
        font-size: 15px;
        font-weight: 600;
        letter-spacing: 0.4px;
        cursor: pointer;
        transition: all 0.25s ease;
        margin-top: 12px;
        box-shadow: 0 8px 22px rgba(212, 20, 20, 0.30);
    }

        .register-btn:hover {
            background: linear-gradient(135deg, #8b0000, #d41414, #ff7a2f);
            transform: translateY(-2px);
            box-shadow: 0 12px 28px rgba(212, 20, 20, 0.40);
        }

    .login-text {
        text-align: center;
        margin-top: 18px;
        color: #8c6666;
        font-size: 13px;
    }

        .login-text a {
            color: #c11212;
            font-weight: 600;
            text-decoration: none;
        }

            .login-text a:hover {
                color: #ff4a1c;
            }

    .validation {
        color: #d20a0a;
        font-size: 12px;
        margin-top: 4px;
        display: block;
    }

    .success-message {
        background: #fff4e0;
        color: #8a4b00;
        padding: 12px 15px;
        border-radius: 10px;
        margin-bottom: 20px;
        font-size: 14px;
        border-left: 4px solid #ff9a1f;
    }

    /* RESPONSIVE */

    @@media (max-width: 800px) {

        .register-container {
            display: block;
        }

        .register-left,
        .register-right {
            width: auto;
        }

        .register-left {
            padding: 35px 30px;
        }

        .register-right {
            padding: 35px 25px;
        }

        .row-flex {
            display: block;
        }
    }
</style>

<div class="client-register-page">

    <div class="register-container">

        <div class="register-left">

            <div class="brand-icon">
                💼
            </div>

            <h1>Build your team.<br />Get work done.</h1>

            <p>
                Create your client account and connect with skilled
                freelancers who can bring your projects to life.
            </p>

            <div class="benefit">
                <div class="benefit-icon">✓</div>
                Find skilled freelancers
            </div>

            <div class="benefit">
                <div class="benefit-icon">✓</div>
                Post projects easily
            </div>

            <div class="benefit">
                <div class="benefit-icon">✓</div>
                Review freelancer proposals
            </div>

            <div class="benefit">
                <div class="benefit-icon">✓</div>
                Manage your projects
            </div>

        </div>

        <div class="register-right">

            <div class="form-heading">
                <h2>Create Client Account</h2>
                <p>Enter your details to get started.</p>
            </div>


            @using (Html.BeginForm("ButtonClick", "ClientRegistration", FormMethod.Post,
                new { enctype = "multipart/form-data" }))
            {
                @Html.AntiForgeryToken()

                <div class="section-title">
                    Personal Information
                </div>

                <div class="row-flex">

                    <div class="form-group">
                        <label class="form-label">Client Name</label>

                        @Html.TextBoxFor(m => m.CName, new
                        {
                            @class = "form-control",
                            placeholder = "Enter your name"
                        })

                        @Html.ValidationMessageFor(m => m.CName, "",
                            new { @class = "validation" })
                    </div>

                    <div class="form-group">
                        <label class="form-label">Phone Number</label>

                        @Html.TextBoxFor(m => m.CPhone, new
                        {
                            @class = "form-control",
                            placeholder = "Enter phone number"
                        })

                        @Html.ValidationMessageFor(m => m.CPhone, "",
                            new { @class = "validation" })
                    </div>

                </div>

                <div class="form-group">

                    <label class="form-label">Email Address</label>

                    @Html.TextBoxFor(m => m.CEmail, new
                    {
                        @class = "form-control",
                        placeholder = "name@example.com",
                        type = "email"
                    })

                    @Html.ValidationMessageFor(m => m.CEmail, "",
                        new { @class = "validation" })

                </div>

                <div class="form-group">

                    <label class="form-label">Address</label>

                    @Html.TextAreaFor(m => m.CAddress, new
                    {
                        @class = "form-control",
                        placeholder = "Enter your address"
                    })

                </div>

                <div class="section-title">
                    Company Information
                </div>

                <div class="form-group">

                    <label class="form-label">Company Name</label>

                    @Html.TextBoxFor(m => m.CCompany_Name, new
                    {
                        @class = "form-control",
                        placeholder = "Enter company name"
                    })

                </div>

                <div class="form-group">

                    <label class="form-label">Company Description</label>

                    @Html.TextAreaFor(m => m.CC_Description, new
                    {
                        @class = "form-control",
                        placeholder = "Tell us briefly about your company"
                    })

                </div>

                <div class="form-group">

                    <label class="form-label">
                        Company / Profile Photo
                    </label>

                    <div class="photo-box">

                        <input type="file"
                               name="file"
                               accept="image/*" />

                    </div>

                </div>

                <div class="section-title">
                    Login Information
                </div>

                <div class="row-flex">

                    <div class="form-group">

                        <label class="form-label">Username</label>

                        @Html.TextBoxFor(m => m.CUsername, new
                        {
                            @class = "form-control",
                            placeholder = "Choose a username"
                        })

                    </div>

                    <div class="form-group">

                        <label class="form-label">Password</label>

                        @Html.PasswordFor(m => m.CPassword, new
                        {
                            @class = "form-control",
                            placeholder = "Create a password"
                        })

                    </div>
                    <div class="form-group">

                        <label class="form-label">Confirm Password</label>

                        @Html.PasswordFor(m => m.CCPassword, new
                        {
                            @class = "form-control",
                            placeholder = "Confirm your password"
                        })

                        @Html.ValidationMessageFor(m => m.CCPassword, "",
                            new { @class = "validation" })

                    </div>

                </div>

                <input type="submit"
                       value="Create Account"
                       class="register-btn" />

                <div class="login-text">

                    Already have an account?

                    <a href="@Url.Action("LoginPage", "Login")">
                        Sign in
                    </a>

                </div>
                <div class="success-message">
                    @Html.DisplayFor(m => m.CMsg)
                </div>

            }

        </div>

    </div>

</div>