@model MVC_Project_Freelance.Models.LoginClass

@{
    ViewBag.Title = "Login";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .login-page {
        min-height: calc(100vh - 70px);
        background: radial-gradient(circle at 12% 18%, rgba(212, 20, 20, 0.10), transparent 40%), radial-gradient(circle at 88% 85%, rgba(255, 140, 0, 0.12), transparent 40%), linear-gradient(135deg, #fff5f3, #ffe9e4 55%, #fff8f0);
        padding: 60px 20px;
        display: flex;
        align-items: center;
    }

    .login-container {
        width: 100%;
        max-width: 900px;
        margin: auto;
        background: #ffffff;
        border-radius: 22px;
        overflow: hidden;
        box-shadow: 0 25px 60px rgba(160, 20, 20, 0.18), 0 4px 14px rgba(160, 20, 20, 0.08);
        display: flex;
        border-top: 4px solid #c11212;
    }

    /* LEFT SIDE */

    .login-left {
        width: 42%;
        background: linear-gradient(160deg, #5c0000 0%, #a80d0d 50%, #e8431a 100%);
        color: white;
        padding: 55px 40px;
        display: flex;
        flex-direction: column;
        justify-content: center;
        position: relative;
        overflow: hidden;
    }

        .login-left::before {
            content: "";
            position: absolute;
            width: 300px;
            height: 300px;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.08);
            top: -110px;
            right: -110px;
        }

        .login-left::after {
            content: "";
            position: absolute;
            width: 220px;
            height: 220px;
            border-radius: 50%;
            background: rgba(255, 190, 60, 0.14);
            bottom: -80px;
            left: -80px;
        }

    .brand-icon {
        width: 58px;
        height: 58px;
        border-radius: 16px;
        background: rgba(255, 255, 255, 0.18);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 26px;
        margin-bottom: 25px;
        box-shadow: 0 8px 20px rgba(0, 0, 0, 0.18);
        border: 1px solid rgba(255, 255, 255, 0.25);
        position: relative;
        z-index: 1;
    }

    .login-left h1 {
        font-size: 34px;
        font-weight: 700;
        line-height: 1.2;
        margin-bottom: 18px;
        text-shadow: 0 3px 12px rgba(0, 0, 0, 0.25);
        position: relative;
        z-index: 1;
    }

    .login-left p {
        color: #ffe9e4;
        font-size: 15px;
        line-height: 1.7;
        position: relative;
        z-index: 1;
    }

    /* RIGHT SIDE */

    .login-right {
        width: 58%;
        padding: 55px 50px;
        background: #ffffff;
        display: flex;
        flex-direction: column;
        justify-content: center;
    }

    .form-heading {
        margin-bottom: 28px;
    }

        .form-heading h2 {
            font-size: 27px;
            font-weight: 700;
            color: #3a0505;
            margin-bottom: 6px;
        }

        .form-heading p {
            color: #8c6666;
            font-size: 14px;
        }

    .form-group {
        margin-bottom: 18px;
    }

    .form-label {
        display: block;
        font-size: 13px;
        font-weight: 600;
        color: #552020;
        margin-bottom: 7px;
    }

    .form-control {
        width: 100%;
        height: 47px;
        border: 1px solid #f0d3cc;
        border-radius: 10px;
        padding: 0 13px;
        font-size: 14px;
        color: #333;
        background: #fffaf9;
        transition: all 0.2s ease;
        box-sizing: border-box;
    }

        .form-control:focus {
            border-color: #d41414;
            background: #ffffff;
            box-shadow: 0 0 0 4px rgba(212, 20, 20, 0.10);
            outline: none;
        }

    .login-btn {
        width: 100%;
        height: 50px;
        border: none;
        border-radius: 12px;
        background: linear-gradient(135deg, #a80d0d, #e0201a, #ff5a1f);
        color: white;
        font-size: 15px;
        font-weight: 600;
        letter-spacing: 0.4px;
        cursor: pointer;
        transition: all 0.25s ease;
        margin-top: 8px;
        box-shadow: 0 8px 22px rgba(212, 20, 20, 0.30);
    }

        .login-btn:hover {
            background: linear-gradient(135deg, #8b0000, #d41414, #ff7a2f);
            transform: translateY(-2px);
            box-shadow: 0 12px 28px rgba(212, 20, 20, 0.40);
        }

    .validation {
        color: #d20a0a;
        font-size: 12px;
        margin-top: 4px;
        display: block;
    }

    .error-message {
        background: #fff0ee;
        color: #a80d0d;
        padding: 12px 15px;
        border-radius: 10px;
        margin-bottom: 20px;
        font-size: 14px;
        border-left: 4px solid #d41414;
    }

    .success-message {
        background: #fff4e0;
        color: #8a4b00;
        padding: 12px 15px;
        border-radius: 10px;
        margin-bottom: 20px;
        font-size: 14px;
        border-left: 4px solid #ff9a1f;
    }

    .register-links {
        text-align: center;
        margin-top: 24px;
        padding-top: 20px;
        border-top: 2px solid #fbdcd6;
        color: #8c6666;
        font-size: 13px;
    }

        .register-links a {
            color: #c11212;
            font-weight: 600;
            text-decoration: none;
        }

            .register-links a:hover {
                color: #ff4a1c;
            }

        .register-links .divider {
            margin: 0 8px;
            color: #e4b5ad;
        }

    /* RESPONSIVE */

    @@media (max-width: 800px) {

        .login-container {
            display: block;
        }

        .login-left,
        .login-right {
            width: auto;
        }

        .login-left {
            padding: 35px 30px;
        }

        .login-right {
            padding: 35px 25px;
        }
    }
</style>

<div class="login-page">

    <div class="login-container">

        <div class="login-left">

            <div class="brand-icon">
                🔐
            </div>

            <h1>Welcome back.</h1>

            <p>
                Sign in to manage your projects, connect with clients
                and freelancers, and keep your work moving.
            </p>

        </div>

        <div class="login-right">

            <div class="form-heading">
                <h2>Sign In</h2>
                <p>Enter your username and password to continue.</p>
            </div>

            @if (TempData["RegMsg"] != null)
            {
                <div class="success-message">@TempData["RegMsg"]</div>
            }

            @if (!string.IsNullOrEmpty(Model?.LMsg))
            {
                <div class="error-message">@Model.LMsg</div>
            }

            @using (Html.BeginForm("ButtonClick", "Login", FormMethod.Post))
            {
                @Html.AntiForgeryToken()

                <div class="form-group">

                    <label class="form-label">Username</label>

                    @Html.TextBoxFor(m => m.LUsername, new
                    {
                        @class = "form-control",
                        placeholder = "Enter your username"
                    })

                    @Html.ValidationMessageFor(m => m.LUsername, "",
                        new { @class = "validation" })

                </div>

                <div class="form-group">

                    <label class="form-label">Password</label>

                    @Html.PasswordFor(m => m.LPassword, new
                    {
                        @class = "form-control",
                        placeholder = "Enter your password"
                    })

                    @Html.ValidationMessageFor(m => m.LPassword, "",
                        new { @class = "validation" })

                </div>

                <input type="submit"
                       value="Sign In"
                       class="login-btn" />
            }

            <div class="register-links">
                New here? Register as
                <a href="@Url.Action("ClientRegPage", "ClientRegistration")">Client</a>
                <span class="divider">|</span>
                <a href="@Url.Action("FreelancerRegPage", "FreelancerRegistration")">Freelancer</a>
            </div>

        </div>

    </div>

</div>