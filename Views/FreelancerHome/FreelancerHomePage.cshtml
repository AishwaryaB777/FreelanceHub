@model List<MVC_Project_Freelance.Models.ProjectSearch>

@{
    ViewBag.Title = "Freelancer Home";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>

    /* =========================================================
       FIXED PAGE - NO PAGE SCROLL
       ========================================================= */

    html,
    body {
        width: 100%;
        height: 100%;
        margin: 0;
        padding: 0;
        overflow: hidden;
    }

    .home-page {
        width: 100%;
        height: calc(100vh - 70px);
        background: radial-gradient( circle at 12% 18%, rgba(212, 20, 20, 0.10), transparent 40% ), radial-gradient( circle at 88% 85%, rgba(255, 140, 0, 0.12), transparent 40% ), linear-gradient( 135deg, #fff5f3, #ffe9e4 55%, #fff8f0 );
        padding: 25px 20px;
        box-sizing: border-box;
        overflow: hidden;
    }


    /* =========================================================
       MAIN CONTAINER
       ========================================================= */

    .home-container {
        width: 100%;
        max-width: 1400px;
        height: 100%;
        margin: auto;
        display: flex;
        flex-direction: column;
        min-height: 0;
    }


    /* =========================================================
       TOP BANNER
       ========================================================= */

    .home-hero {
        background: linear-gradient( 160deg, #5c0000 0%, #a80d0d 50%, #e8431a 100% );
        color: white;
        border-radius: 18px;
        padding: 25px 32px;
        box-shadow: 0 20px 45px rgba(160, 20, 20, 0.18);
        border-top: 4px solid #ffb43c;
        margin-bottom: 18px;
        position: relative;
        overflow: hidden;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        flex-shrink: 0;
    }


        .home-hero::before {
            content: "";
            position: absolute;
            width: 250px;
            height: 250px;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.08);
            top: -120px;
            right: -80px;
        }


        .home-hero::after {
            content: "";
            position: absolute;
            width: 180px;
            height: 180px;
            border-radius: 50%;
            background: rgba(255, 190, 60, 0.14);
            bottom: -90px;
            left: 30%;
        }


    .hero-text {
        position: relative;
        z-index: 1;
    }


        .hero-text h1 {
            font-size: 28px;
            font-weight: 700;
            margin: 0 0 6px;
            text-shadow: 0 3px 12px rgba(0, 0, 0, 0.25);
        }


        .hero-text p {
            color: #ffe9e4;
            font-size: 13px;
            margin: 0;
            line-height: 1.5;
        }


    /* =========================================================
       LOGOUT BUTTON
       ========================================================= */

    .logout-btn {
        position: relative;
        z-index: 1;
        background: rgba(255, 255, 255, 0.16);
        border: 1px solid rgba(255, 255, 255, 0.35);
        color: #ffffff;
        padding: 9px 20px;
        border-radius: 9px;
        font-size: 13px;
        font-weight: 600;
        text-decoration: none;
        transition: all 0.2s ease;
        white-space: nowrap;
    }


        .logout-btn:hover {
            background: rgba(255, 255, 255, 0.28);
            color: #ffffff;
            text-decoration: none;
        }


    /* =========================================================
       PROJECT CARD
       ========================================================= */

    .projects-card {
        background: #ffffff;
        border-radius: 18px;
        padding: 22px 25px 18px;
        box-shadow: 0 20px 45px rgba(160, 20, 20, 0.14), 0 4px 14px rgba(160, 20, 20, 0.08);
        border-top: 4px solid #c11212;
        flex: 1;
        min-height: 0;
        display: flex;
        flex-direction: column;
        overflow: hidden;
        box-sizing: border-box;
    }


    /* =========================================================
       CARD HEADER
       ========================================================= */

    .card-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        flex-wrap: wrap;
        margin-bottom: 12px;
        flex-shrink: 0;
    }


        .card-top h2 {
            font-size: 22px;
            font-weight: 700;
            color: #3a0505;
            margin: 0 0 3px;
        }


        .card-top p {
            color: #8c6666;
            font-size: 12px;
            margin: 0;
        }


    .count-badge {
        display: inline-block;
        background: #fff0ed;
        color: #a80d0d;
        font-size: 11px;
        font-weight: 700;
        padding: 3px 9px;
        border-radius: 20px;
        margin-left: 7px;
        vertical-align: middle;
    }


    /* =========================================================
       SEARCH FORM
       ========================================================= */

    .filter-area {
        width: 100%;
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 10px;
        margin-top: 10px;
        margin-bottom: 15px;
        flex-shrink: 0;
    }


    .search-box {
        width: 100%;
        height: 38px;
        border: 1px solid #f0d3cc;
        border-radius: 8px;
        padding: 0 12px;
        font-size: 12px;
        background: #fffaf9;
        box-sizing: border-box;
        transition: all 0.2s ease;
    }


        .search-box:focus {
            border-color: #d41414;
            background: #ffffff;
            box-shadow: 0 0 0 3px rgba(212, 20, 20, 0.10);
            outline: none;
        }


    /* =========================================================
       SEARCH BUTTON
       ========================================================= */

    .search-button {
        height: 38px;
        border: none;
        border-radius: 8px;
        background: linear-gradient( 135deg, #a80d0d, #d41414 );
        color: #ffffff;
        font-size: 12px;
        font-weight: 700;
        cursor: pointer;
        transition: all 0.2s ease;
        box-shadow: 0 3px 8px rgba(168, 13, 13, 0.12);
    }


        .search-button:hover {
            background: linear-gradient( 135deg, #7d0505, #b30c0c );
            transform: translateY(-1px);
            box-shadow: 0 5px 12px rgba(168, 13, 13, 0.25);
        }


    /* =========================================================
       RESET BUTTON
       ========================================================= */

    .reset-button {
        height: 38px;
        border: 1px solid #e6c5be;
        border-radius: 8px;
        background: #fff7f5;
        color: #8f0808;
        font-size: 12px;
        font-weight: 600;
        text-decoration: none;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.2s ease;
    }


        .reset-button:hover {
            background: #fff0ed;
            color: #a80d0d;
            text-decoration: none;
        }


    /* =========================================================
       SEARCH ACTION AREA
       ========================================================= */

    .search-actions {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 10px;
    }


    /* =========================================================
       TABLE SCROLL CONTAINER
       ========================================================= */

    .table-wrap {
        width: 100%;
        flex: 1;
        min-height: 0;
        overflow-y: auto;
        overflow-x: hidden;
        border-radius: 10px;
        border: 1px solid #f6dcd6;
        box-sizing: border-box;
    }


    /* =========================================================
       TABLE
       ========================================================= */

    .project-table {
        width: 100%;
        border-collapse: collapse;
        table-layout: fixed;
        font-size: 12px;
    }


        /* =========================================================
       TABLE HEADER
       ========================================================= */

        .project-table thead {
            height: 42px;
        }


            .project-table thead th {
                background: linear-gradient( 135deg, #a80d0d, #d41414 );
                color: #ffffff;
                text-align: left;
                font-size: 10px;
                font-weight: 600;
                letter-spacing: 0.4px;
                text-transform: uppercase;
                padding: 10px 8px;
                white-space: nowrap;
                position: sticky;
                top: 0;
                z-index: 10;
            }


        /* =========================================================
       TABLE BODY
       ========================================================= */

        .project-table tbody td {
            padding: 9px 8px;
            border-bottom: 1px solid #f6e3df;
            color: #552020;
            vertical-align: middle;
            overflow: hidden;
            text-overflow: ellipsis;
        }


        .project-table tbody tr:last-child td {
            border-bottom: none;
        }


        .project-table tbody tr:hover {
            background: #fff6f4;
        }


        /* =========================================================
       COLUMN WIDTHS
       ========================================================= */

        .project-table th:nth-child(1),
        .project-table td:nth-child(1) {
            width: 19%;
        }


        .project-table th:nth-child(2),
        .project-table td:nth-child(2) {
            width: 10%;
        }


        .project-table th:nth-child(3),
        .project-table td:nth-child(3) {
            width: 8%;
        }


        .project-table th:nth-child(4),
        .project-table td:nth-child(4) {
            width: 12%;
        }


        .project-table th:nth-child(5),
        .project-table td:nth-child(5) {
            width: 8%;
        }


        .project-table th:nth-child(6),
        .project-table td:nth-child(6) {
            width: 9%;
        }


        .project-table th:nth-child(7),
        .project-table td:nth-child(7) {
            width: 10%;
        }


        .project-table th:nth-child(8),
        .project-table td:nth-child(8) {
            width: 12%;
        }


        .project-table th:nth-child(9),
        .project-table td:nth-child(9) {
            width: 8%;
        }


    /* =========================================================
       PROJECT TEXT
       ========================================================= */

    .p-title {
        font-weight: 700;
        color: #3a0505;
        font-size: 13px;
        margin-bottom: 2px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }


    .p-desc {
        color: #8c6666;
        font-size: 10px;
        line-height: 1.35;
        max-width: 100%;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }


    .company {
        font-weight: 600;
        color: #a80d0d;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }


    .type-badge {
        display: inline-block;
        background: #fff4e0;
        color: #8a4b00;
        border: 1px solid #ffd9a0;
        font-size: 10px;
        font-weight: 600;
        padding: 3px 7px;
        border-radius: 15px;
        white-space: nowrap;
        max-width: 100%;
        overflow: hidden;
        text-overflow: ellipsis;
    }


    .skill-text {
        font-size: 11px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }


    .budget {
        font-weight: 700;
        color: #3a0505;
        white-space: nowrap;
    }


    .nowrap {
        white-space: nowrap;
    }


    .date-to {
        color: #8c6666;
    }


    /* =========================================================
       APPLY BUTTON
       ========================================================= */

    .apply-btn {
        display: inline-block;
        background: linear-gradient( 135deg, #a80d0d, #d41414 );
        color: #ffffff;
        padding: 6px 11px;
        border-radius: 7px;
        text-decoration: none;
        font-size: 10px;
        font-weight: 700;
        transition: all 0.2s ease;
        white-space: nowrap;
        box-shadow: 0 3px 8px rgba(168, 13, 13, 0.12);
    }


        .apply-btn:hover {
            background: linear-gradient( 135deg, #7d0505, #b30c0c );
            color: #ffffff;
            text-decoration: none;
            transform: translateY(-1px);
            box-shadow: 0 5px 12px rgba(168, 13, 13, 0.25);
        }


    /* =========================================================
       EMPTY STATE
       ========================================================= */

    .empty-state {
        text-align: center;
        padding: 35px 20px;
        color: #8c6666;
        font-size: 14px;
    }


        .empty-state .icon {
            font-size: 35px;
            margin-bottom: 8px;
        }


    /* =========================================================
       CUSTOM SCROLLBAR
       ========================================================= */

    .table-wrap::-webkit-scrollbar {
        width: 8px;
    }


    .table-wrap::-webkit-scrollbar-track {
        background: #fff1ee;
        border-radius: 10px;
    }


    .table-wrap::-webkit-scrollbar-thumb {
        background: #c11212;
        border-radius: 10px;
    }


        .table-wrap::-webkit-scrollbar-thumb:hover {
            background: #8f0808;
        }


    /* =========================================================
       RESPONSIVE
       ========================================================= */

    @@media (max-width: 1100px) {

        .home-page {
            padding: 15px;
        }


        .home-hero {
            padding: 20px 25px;
        }


        .hero-text h1 {
            font-size: 24px;
        }


        .projects-card {
            padding: 18px;
        }


        .project-table {
            font-size: 10px;
        }


            .project-table thead th {
                font-size: 9px;
                padding: 8px 5px;
            }


            .project-table tbody td {
                padding: 7px 5px;
            }


        .apply-btn {
            padding: 5px 8px;
            font-size: 9px;
        }
    }


    @@media (max-width: 850px) {

        html,
        body {
            overflow: hidden;
        }


        .home-page {
            height: calc(100vh - 70px);
            min-height: 0;
            overflow: hidden;
        }


        .home-container {
            height: 100%;
            min-height: 0;
        }


        .projects-card {
            min-height: 0;
            overflow: hidden;
        }


        .filter-area {
            grid-template-columns: repeat(2, 1fr);
        }


        .table-wrap {
            overflow-y: auto;
            overflow-x: hidden;
        }
    }


    @@media (max-width: 500px) {

        .filter-area {
            grid-template-columns: 1fr;
        }


        .search-actions {
            grid-template-columns: 1fr;
        }


        .search-box {
            width: 100%;
        }


        .home-hero {
            display: block;
        }


        .logout-btn {
            display: inline-block;
            margin-top: 15px;
        }
    }
</style>


<div class="home-page">

    <div class="home-container">


        <!-- =====================================================
             HERO
             ===================================================== -->

        <div class="home-hero">

            <div class="hero-text">

                <h1>
                    Welcome, Freelancer 🚀
                </h1>

                <p>
                    Browse the latest projects posted by clients and
                    find the work that matches your skills.
                </p>

            </div>


            <a class="logout-btn"
               href="@Url.Action("LoginPage", "Login")">

                Log out

            </a>

        </div>


        <!-- =====================================================
             PROJECT CARD
             ===================================================== -->

        <div class="projects-card">


            <!-- =================================================
                 CARD HEADER
                 ================================================= -->

            <div class="card-top">

                <div>

                    <h2>

                        Available Projects

                        <span class="count-badge">
                            @Model.Count
                        </span>

                    </h2>


                    <p>
                        Search and explore projects posted by clients.
                    </p>

                </div>

            </div>


            <!-- =================================================
                 SEARCH FORM
                 ================================================= -->

            <form method="post"
                  action="@Url.Action("searchproject_click", "FreelancerHome")">

                <div class="filter-area">


                    <!-- SKILL -->

                    <input type="text"
                           name="PSkill"
                           class="search-box"
                           placeholder="🔧 Search Skill..."
                           value="@Request["PSkill"]" />


                    <!-- PROJECT TYPE -->

                    <input type="text"
                           name="PType"
                           class="search-box"
                           placeholder="📁 Project Type..."
                           value="@Request["PType"]" />


                    <!-- BUDGET -->

                    <input type="text"
                           name="PBudget"
                           class="search-box"
                           placeholder="💰 Budget..."
                           value="@Request["PBudget"]" />


                    <!-- EXPERIENCE -->

                    <input type="number"
                           name="PExperiance"
                           class="search-box"
                           placeholder="🎓 Max Experience..."
                           value="@Request["PExperiance"]" />

                </div>


                <div class="search-actions">

                    <button type="submit"
                            class="search-button">

                        🔍 Search Projects

                    </button>


                    <a href="@Url.Action("FreelancerHomePage", "FreelancerHome")"
                       class="reset-button">

                        ↻ Reset

                    </a>

                </div>

            </form>


            <!-- =================================================
                 EMPTY STATE
                 ================================================= -->

            @if (Model == null || !Model.Any())
            {

                <div class="empty-state">

                    <div class="icon">
                        📭
                    </div>

                    No projects found.

                    <br />

                    Try changing your search filters or check back later.

                </div>

            }
            else
            {

                <!-- =================================================
                     TABLE
                     ================================================= -->

                <div class="table-wrap">


                    <table class="project-table"
                           id="projectTable">


                        <!-- TABLE HEADER -->

                        <thead>

                            <tr>

                                <th>
                                    Project
                                </th>

                                <th>
                                    Company
                                </th>

                                <th>
                                    Type
                                </th>

                                <th>
                                    Skills
                                </th>

                                <th>
                                    Budget
                                </th>

                                <th>
                                    Experience
                                </th>

                                <th>
                                    Location
                                </th>

                                <th>
                                    Duration
                                </th>

                                <th>
                                    Action
                                </th>

                            </tr>

                        </thead>


                        <!-- TABLE BODY -->

                        <tbody>

                            @foreach (var p in Model)
                            {

                                int exp = 0;

                                if (p.PExperiance != null)
                                {
                                    exp = Convert.ToInt32(p.PExperiance);
                                }


                                string endDate = "";

                                if (p.PEnd != null)
                                {
                                    endDate =
                                        Convert.ToDateTime(p.PEnd)
                                        .ToString("dd MMM yyyy");
                                }


                                <tr>


                                    <!-- =================================
                                         PROJECT
                                         ================================= -->

                                    <td>

                                        <div class="p-title">

                                            @p.PTitle

                                        </div>


                                        <div class="p-desc">

                                            @(p.PDescription != null &&
                                              p.PDescription.Length > 100
                                                ? p.PDescription.Substring(0, 100) + "..."
                                                : p.PDescription)

                                        </div>

                                    </td>


                                    <!-- =================================
                                         COMPANY
                                         ================================= -->

                                    <td class="company">

                                        @p.CCompany_Name

                                    </td>


                                    <!-- =================================
                                         PROJECT TYPE
                                         ================================= -->

                                    <td>

                                        <span class="type-badge">

                                            @p.PType

                                        </span>

                                    </td>


                                    <!-- =================================
                                         SKILLS
                                         ================================= -->

                                    <td class="skill-text">

                                        @p.PSkill

                                    </td>


                                    <!-- =================================
                                         BUDGET
                                         ================================= -->

                                    <td class="budget">

                                        ₹@p.PBudget

                                    </td>


                                    <!-- =================================
                                         EXPERIENCE
                                         ================================= -->

                                    <td class="nowrap">

                                        @(exp == 0
                                            ? "Fresher"
                                            : exp + " yr(s)")

                                    </td>


                                    <!-- =================================
                                         LOCATION
                                         ================================= -->

                                    <td>

                                        @p.PLocation

                                    </td>


                                    <!-- =================================
                                         END DATE
                                         ================================= -->

                                    <td class="nowrap">

                                        @endDate

                                    </td>


                                    <!-- =================================
                                         APPLY
                                         ================================= -->

                                    <td>

                                        <a href="@Url.Action("ApplicationPage","ApplyProject",new { pid = p.PId })"
                                           class="apply-btn">
                                            Apply
                                        </a>
                                    </td>


                                </tr>

                            }

                        </tbody>

                    </table>

                </div>

            }

        </div>

    </div>

</div>